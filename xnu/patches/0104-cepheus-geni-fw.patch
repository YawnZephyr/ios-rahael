+/*
+ * Load the SM8150 I2C serial-engine firmware into SE17.
+ *
+ * The bootloader on this board never initialises the touch I2C engine, so
+ * GENI sits in force-default with its FIFO interface disabled and the driver's
+ * "ABL-loaded firmware" precondition fails. The blob below is the I2C segment
+ * of the stock qupv3fw.elf (core 0x10030000, fw 0x103, cfg 4).
+ */
+static void
+ceph_geni_load_i2c_fw(void)
+{
+	volatile uint32_t *se = (volatile uint32_t *)st.se;
+	volatile uint32_t *wrap = (volatile uint32_t *)ml_io_map(0x00cc0000, 0x6000);
+	uint32_t v;
+
+	if (!wrap) {
+		printf("SWEET TOUCH: wrapper map failed\n");
+		return;
+	}
+
+	/* wrapper: let hardware run the branch/CGC for us */
+	wrap[0x120 / 4] |= (1u << 0);		/* FAST_SWITCH_TO_HIGH_DISABLE */
+	wrap[0x118 / 4] |= (1u << 0);		/* AHB_M_CLK_CGC_ON */
+	wrap[0x21c / 4] |= (1u << 0);		/* COMMON_CSR_SLV_CLK_CGC_ON */
+
+	/* stop the GENI core while the RAM is programmed */
+	se[0x24 / 4] = 0;					/* GENI_OUTPUT_CTRL */
+	se[0x28 / 4] |= (1u << 6) | (1u << 7);	/* PROG_RAM_SCLK_OFF|HCLK_OFF */
+	se[0x2000 / 4] = 0;					/* GENI_CLK_CTRL */
+	se[0x28 / 4] &= ~((1u << 6) | (1u << 7));
+	se[0xe30 / 4] |= (1u << 3) | (1u << 2) | (1u << 1) | (1u << 0);
+	se[0x28 / 4] = 1u;					/* DEFAULT_CGC_EN */
+
+	/* config-table version, then the primitive table itself */
+	se[0x00 / 4] = 4u;					/* INIT_CFG_REVISION */
+	se[0x04 / 4] = 4u;					/* S_INIT_CFG_REVISION */
+	for (unsigned i = 0; i < 66u; i++) {
+		se[(0x100u + ceph_geni_i2c_cfg_idx[i] * 4u) / 4] = ceph_geni_i2c_cfg_val[i];
+	}
+
+	/* firmware revision: protocol 3 (I2C), version 0x103 */
+	se[0x1000 / 4] = (3u << 8) | 0x103u;	/* GENI_FW_REVISION */
+	se[0x1004 / 4] = (3u << 8) | 0x103u;	/* S_FW_REVISION */
+
+	/* the firmware image itself, into GENI RAM */
+	for (unsigned i = 0; i < 303u; i++) {
+		se[(0x1010u + i * 4u) / 4] = ceph_geni_i2c_fw[i];
+	}
+
+	se[0x20 / 4] = 1u;					/* FORCE_DEFAULT: park the pads */
+	se[0x28 / 4] |= (1u << 6) | (1u << 7);
+	se[0x7c / 4] |= 1u;					/* CLK_SEL: SER_CLK_SEL */
+	se[0x28 / 4] &= ~((1u << 6) | (1u << 7));
+
+	se[0x2004 / 4] |= 1u;				/* DMA_IF_EN */
+	se[0x2008 / 4] &= ~1u;				/* FIFO_IF_DISABLE = 0 */
+
+
+	printf("SWEET TOUCH: GENI i2c firmware loaded, if-disable=%#x fw=%#x\n",
+	    se[0x64 / 4], se[0x68 / 4]);
+}
